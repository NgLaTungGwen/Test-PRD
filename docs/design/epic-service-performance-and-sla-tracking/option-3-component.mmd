C4Component
  title Component view - metric compiler
  ContainerDb(fx, "Fixture bundle", "JSON", "Raw rows")
  Container_Boundary(compiler, "Metric compiler") {
    Component(loader, "Fixture loader", "TypeScript", "Reads and types rows")
    Component(calc, "Calculator library", "TypeScript", "Funnel, SLA, MTTA")
    Component(grade, "Grade mapper", "TypeScript", "Posture score bands")
    Component(writer, "Snapshot writer", "TypeScript", "Emits typed artifact")
